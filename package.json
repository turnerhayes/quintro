{
  "name": "quintro",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc",
    "i18n:extract": "formatjs extract \"src/**/*.{tsx,ts}\" --ignore \"**/*.d.ts\" --out-file src/translations/lang.json",
    "i18n:compile": "formatjs compile src/translations/lang.json",
    "i18n:extract-compile": "formatjs extract \"src/**/*.{tsx,ts}\" --ignore \"**/*.d.ts\" --out-file temp.json --flatten --id-interpolation-pattern '[sha512:contenthash:base64:6]' && formatjs compile 'temp.json' --out-file src/translations/en.json && rm temp.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.6",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@react-router/node": "^7.6.3",
    "@reduxjs/toolkit": "^2.8.2",
    "classnames": "^2.5.1",
    "isbot": "^5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-intl": "^7.1.11",
    "react-redux": "^9.2.0",
    "react-router": "^7.6.3",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@formatjs/cli": "^6.7.2",
    "@react-router/dev": "^7.6.3",
    "@types/node": "^24.0.10",
    "@types/notifyjs": "^3.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-dom": "^1.52.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-react-x": "^1.52.2",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0",
    "vite-plugin-checker": "^0.9.3"
  }
}
