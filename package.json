{
  "name": "quintro",
  "version": "1.0.0",
  "main": "index.js",
  "engine": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "webpack-dev-server",
    "build:client": "webpack",
    "build:server": "tsc --project tsconfig.server.json",
    "server:dev": "nodemon --config nodemon.json --exec \"ts-node --project ./src/server/tsconfig.json -r tsconfig-paths/register src/server/index.ts\"",
    "sockets:dev": "nodemon --config nodemon.json --exec \"ts-node --project ./src/server/sockets/tsconfig.json -r tsconfig-paths/register src/server/sockets/index.ts\"",
    "i18n:extract": "formatjs extract \"src/app/**/*.{tsx,ts}\" --ignore \"**/*.d.ts\" --out-file src/app/translations/lang.json",
    "i18n:compile": "formatjs compile src/app/translations/lang.json",
    "i18n:extract-compile": "formatjs extract \"src/app/**/*.{tsx,ts}\" --ignore \"**/*.d.ts\" --out-file temp.json --flatten --id-interpolation-pattern '[sha512:contenthash:base64:6]' && formatjs compile 'temp.json' --out-file src/app/translations/en.json && rm temp.json",
    "migrate:up": "kysely migrate:up",
    "migrate:down": "kysely migrate:down"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/turnerhayes/quintro"
  },
  "engines": {
    "npm": ">=6",
    "node": ">=8"
  },
  "author": "Turner Hayes <dev@turnerhayes.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/turnerhayes/quintro/issues"
  },
  "homepage": "https://github.com/turnerhayes/quintro#readme",
  "description": "",
  "devDependencies": {
    "@formatjs/cli": "^6.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/express-session": "^1.18.2",
    "@types/pg": "^8.15.4",
    "@types/react-dev-utils": "^9.0.15",
    "@types/react-dom": "^19.0.3",
    "@types/webpack-hot-middleware": "^2.25.9",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-webpack-plugin": "^5.6.3",
    "kysely-ctl": "^0.13.1",
    "nodemon": "^3.1.9",
    "react-dev-utils": "^12.0.1",
    "react-router": "^7.6.3",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^7.4.2",
    "webpack-dev-server": "^5.2.0",
    "webpack-hot-middleware": "^2.26.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.1",
    "@mui/material": "^6.4.1",
    "@reduxjs/toolkit": "^2.5.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "classnames": "^2.5.1",
    "cors": "^2.8.5",
    "css-loader": "^7.1.2",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "immer": "^10.1.1",
    "kysely": "^0.28.2",
    "nanoid": "^5.1.5",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-intl": "^7.1.4",
    "react-redux": "^9.2.0",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "style-loader": "^4.0.0"
  }
}
