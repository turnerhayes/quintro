{
  "name": "quintro",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "test": "vitest",
    "test:chrome": "vitest --browser=chromium",
    "test:chrome:coverage": "vitest --browser=chromium --coverage",
    "test:firefox": "vitest --browser=firefox",
    "test:update-screenshots": "vitest --update",
    "dev": "react-router dev",
    "build": "tsc -b && vite build src/client",
    "lint": "eslint .",
    "preview": "vite preview src/client",
    "typecheck": "react-router typegen && tsc --noEmit",
    "i18n:extract": "formatjs extract \"src/client/**/*.{tsx,ts}\" --ignore \"**/*.d.ts\" --out-file src/client/translations/lang.json",
    "i18n:compile": "formatjs compile src/client/translations/lang.json",
    "i18n": "formatjs extract \"src/client/**/*.{tsx,ts}\" --ignore \"**/*.d.ts\" --out-file temp.json --flatten --id-interpolation-pattern '[sha512:contenthash:base64:6]' && formatjs compile 'temp.json' --out-file src/client/translations/en.json && rm temp.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.6",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@react-router/node": "^7.6.3",
    "@reduxjs/toolkit": "^2.8.2",
    "classnames": "^2.5.1",
    "debug": "^4.4.1",
    "isbot": "^5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-intl": "^7.1.11",
    "react-redux": "^9.2.0",
    "react-router": "^7.6.3",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.1",
    "vitest": "^4.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@formatjs/cli": "^6.7.2",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@react-router/dev": "^7.6.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^24.0.10",
    "@types/notifyjs": "^3.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/redux-persist": "^4.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.29.0",
    "eslint-plugin-react-dom": "^1.52.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-react-x": "^1.52.2",
    "globals": "^16.2.0",
    "msw": "^2.10.4",
    "playwright": "^1.54.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0",
    "vite-plugin-checker": "^0.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest-browser-react": "^1.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
